{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "OpenHop",
  "version": "0.3.3",
  "identifier": "dev.openhop.desktop",
  "build": {
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "OpenHop",
        "width": 1060,
        "height": 720,
        "minWidth": 720,
        "minHeight": 560
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; script-src 'self'"
    },
    "macOSPrivateApi": true
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "Utility",
    "shortDescription": "One keyboard and mouse for all your computers",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "linux": {
      "deb": {
        "files": {
          "/usr/lib/udev/rules.d/60-openhop-uinput.rules": "../../packaging/linux/60-openhop-uinput.rules"
        },
        "postInstallScript": "../../packaging/linux/postinst.sh"
      },
      "rpm": {
        "files": {
          "/usr/lib/udev/rules.d/60-openhop-uinput.rules": "../../packaging/linux/60-openhop-uinput.rules"
        },
        "postInstallScript": "../../packaging/linux/postinst.sh"
      }
    },
    "macOS": {
      "minimumSystemVersion": "11.0"
    }
  }
}